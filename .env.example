# ---------------------------------------------------------------------------
# MODELO de configuração. Copie para `.env.local` e preencha com os seus dados.
#
#   cp .env.example .env.local
#
# `.env.local` está no .gitignore e NUNCA deve ser commitado.
# Este arquivo (.env.example) é versionado de propósito e não contém segredos.
# ---------------------------------------------------------------------------

# Project URL do Supabase (Settings -> Data API -> Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Publishable key / anon key (Settings -> API Keys)
# É uma chave PÚBLICA por design: ela vai embutida no bundle do site.
# Quem protege os dados é o RLS + a senha da conta (que NÃO fica aqui).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# E-mail da conta única de estudo criada no Supabase (Authentication -> Users).
# A SENHA não fica em variável de ambiente: você digita na tela de entrada.
VITE_APP_EMAIL=seu-email@exemplo.com
